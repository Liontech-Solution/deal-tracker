# Configuración del servicio web. Sin secretos reales: copia a .env y ajusta.

# Postgres compartida (contrato con el scraper). Requerido.
DATABASE_URL=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker

# Bases de TEST (solo para `pnpm test`; los specs de integración se SALTAN si no están).
#
# Son dos, y la segunda no sobra (#105): la base del cluster está creada con ctype `C`, y con ese
# ctype `lower()` NO baja las letras acentuadas — `size_canon`, `color_canon` y el plegado de la
# búsqueda se comportan distinto allí que con el locale de CI. Sin la segunda, esos specs se saltan
# y todo sale verde mientras el cluster hace otra cosa, que es exactamente cómo se coló el defecto.
#
#   CREATE DATABASE deal_tracker_ctype_c
#     TEMPLATE template0 ENCODING 'UTF8' LC_COLLATE 'C' LC_CTYPE 'C';
#
# `TEMPLATE template0` es obligatorio para crear una base con otro locale.
TEST_DATABASE_URL=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker_test
TEST_DATABASE_URL_CTYPE_C=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker_ctype_c

# Keycloak (OIDC). El servicio web es un resource server: valida el JWT de acceso
# contra el JWKS del realm. ISSUER_URL es la URL del realm (sin barra final).
#
# TODO el bloque KEYCLOAK_* es OPCIONAL. Un entorno que no se conecta a Keycloak (p.ej. `dev`)
# simplemente no define ninguna: la auth queda apagada, la SPA funciona como catálogo público y
# los endpoints de usuario responden 401. Déjalas vacías para reproducir ese modo en local.
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/deal-tracker
# Audiencia esperada en el token (normalmente el client-id de la SPA o 'account').
KEYCLOAK_AUDIENCE=deal-tracker-web
# Client-id público que `GET /api/config` publica a la SPA. Opcional: si se omite se usa
# KEYCLOAK_AUDIENCE, que en nuestros realms ya vale el propio client-id.
# KEYCLOAK_CLIENT_ID=deal-tracker-web

# Servidor HTTP.
PORT=3000
NODE_ENV=development

# Ubicación de las migraciones (contrato SQL). En la imagen se empaquetan en /app/db/migrations;
# en local, ruta relativa a la raíz del repo.
WEB_MIGRATIONS_DIR=../../db/migrations

# Telegram. Nombre del bot (sin @) para armar el deep-link de vínculo t.me/<bot>?start=<token>.
# Opcional: si se deja vacío, la API de vínculo de Telegram responde 503.
TELEGRAM_BOT_USERNAME=

# Token del bot (BotFather). Opcional: sin él no se envían avisos (quedan en el log) ni se puede
# hacer long-polling. En `dev` va vacío a propósito; se configura a partir de `qa` como secreto.
TELEGRAM_BOT_TOKEN=

# El job de matching (`pnpm job:matching`) usa TELEGRAM_BOT_TOKEN para avisar. Sin él se fuerza
# --dry-run: registra qué habría enviado y no escribe nada.

# Enciende el bucle de long-polling que atiende `/start <token>` y cierra el vínculo.
# Apagado por defecto. `getUpdates` no admite dos consumidores: con esto en `true` el
# Deployment del web debe quedarse en **replica 1**.
TELEGRAM_POLLING_ENABLED=false
