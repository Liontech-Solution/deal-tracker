# Endurecimiento de cadena de suministro (ver plan Fase 2, §7).
# Registro oficial pinneado; sin registries de terceros.
registry=https://registry.npmjs.org/

# Cooldown: no instalar versiones publicadas hace menos de 1 día (1440 min). Da margen a
# que se detecten y retiren paquetes troyanizados antes de que entren en el lockfile.
minimum-release-age=1440

# Los scripts de ciclo de vida de las dependencias están bloqueados por defecto en pnpm 10+;
# solo se permiten los de la allowlist `pnpm.onlyBuiltDependencies` de package.json.
# (Se deja explícito para que quede documentado el endurecimiento.)
