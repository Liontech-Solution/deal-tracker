# Config de la SPA (Vite). Copia a `.env.local`. Solo variables `VITE_*` llegan al navegador.
#
# Login con Keycloak (OIDC + PKCE). Si dejas las tres vacías (o quitas el fichero), la auth queda
# DESHABILITADA: la app funciona como catálogo público y "Iniciar sesión"/"Seguir" muestran un
# placeholder. La validación real del flujo se hace al desplegar en el cluster (namespace `dev`),
# donde el realm y el client existen de verdad; allí estas variables se inyectan en el build.

# URL base de Keycloak (con barra final). Ej.: https://keycloak.dev.example/
VITE_KC_URL=
# Realm.
VITE_KC_REALM=deal-tracker
# Client-id público de la SPA registrado en el realm (con PKCE, sin secreto).
VITE_KC_CLIENT_ID=deal-tracker-web

# Destino del proxy /api en dev (por defecto http://localhost:3000). Opcional.
# API_PROXY_TARGET=http://localhost:3000
