# Copia a .env y ajusta. NO se commitea (.gitignore lo excluye).

# Conexión a Postgres del servicio scraper.
DATABASE_URL=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker

# Base de datos usada por los tests de integración (pytest). Si no se define,
# los tests que tocan Postgres se omiten.
TEST_DATABASE_URL=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker_test

# Ajustes del scraper (opcionales; valores por defecto en config.py).
# SCRAPER_USER_AGENT=
# SCRAPER_REQUEST_TIMEOUT=20
# SCRAPER_REQUEST_DELAY=0.5      # pausa base entre peticiones (se le aplica jitter)
# SCRAPER_REQUEST_RETRIES=3      # reintentos ante 429/5xx/errores de red
# SCRAPER_RETRY_BACKOFF=1.0      # segundos base del backoff exponencial
