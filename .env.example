# Copia a .env y ajusta. NO se commitea (.gitignore lo excluye).

# Conexión a Postgres del servicio scraper.
DATABASE_URL=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker

# Base de datos usada por los tests de integración (pytest). Si no se define,
# los tests que tocan Postgres se omiten.
TEST_DATABASE_URL=postgresql://dealtracker:dealtracker@localhost:5432/deal_tracker_test

# Ajustes del scraper (opcionales; valores por defecto en config.py).
# SCRAPER_USER_AGENT=
# SCRAPER_REQUEST_TIMEOUT=20
# SCRAPER_REQUEST_DELAY=0.5      # pausa base entre peticiones (se le aplica jitter)
# SCRAPER_REQUEST_RETRIES=3      # reintentos ante 429/5xx/errores de red
# SCRAPER_RETRY_BACKOFF=1.0      # segundos base del backoff exponencial
# SCRAPER_DELIST_MIN_BASELINE=5  # población mínima de un ámbito para aplicar la red de seguridad de bajas
# SCRAPER_DELIST_DROP_RATIO=0.5  # si lo visto cae por debajo de este ratio, se omiten las bajas del ámbito
# SCRAPER_DELIST_MIN_MISSES=2    # pasadas seguidas sin ver antes de dar de baja (1 = a la primera)
# SCRAPER_DELIST_PROBE=1         # confirmar con la tienda antes de dar de baja (0 = solo histéresis)
# SCRAPER_DELIST_PROBE_MAX=50    # tope de sondeos por pasada; lo que no se sondea no se da de baja
# SCRAPER_DELIST_PROBE_COOLDOWN_DAYS=7 # no se repregunta a quien ya contestó hace menos (0 = repreguntar siempre)
# SCRAPER_DETAIL_MAX_AGE_DAYS=7  # edad a la que se vuelve a pedir el detalle aunque nada cambie (0 = nunca)
# SCRAPER_DETAIL_REFRESH_MAX=100 # tope de refrescos por pasada (Sfera sirve el detalle de caché: súbelo)
# SCRAPER_DETAIL_REFRESH_ALL=0   # 1 = reobservar todo sin mirar la edad (= --refresh-all): repara un
#                                  catálogo ya ingerido, y el tope de arriba le sigue aplicando
# SCRAPER_SCAN_MAX_DEAD_RATIO=0.34 # proporción de hojas de categoría caídas (404) a partir de la cual la pasada aborta

# Navegador headless (solo tiendas tras anti-bot, p.ej. Sfera). En local requiere el binario:
# `services/scraper/.venv/bin/playwright install chromium`.
# SCRAPER_BROWSER_HEADLESS=1     # 0 = ventana real (dev con display); 1 = headless (cluster/CI)
# SCRAPER_BROWSER_NAV_TIMEOUT=45 # segundos para goto() y peticiones del navegador
# SCRAPER_BROWSER_CHANNEL=       # p.ej. "chrome" para usar Chrome del sistema en vez de Chromium
# Espera a lo que el JS pinta después del HTML inicial (en Hipercor, el selector de tallas).
# Agotarla no es un error: es un detalle que no llega, y ese producto no se actualiza esta pasada.
# SCRAPER_BROWSER_HYDRATE_TIMEOUT=10

# Vigía en vivo (`python -m scraper.vigia`, #67). Opcional POR DISEÑO, igual que Keycloak y
# Telegram en el web: sin estas dos el vigía imprime el informe y sale != 0, pero no abre issue.
# Esa es la ruta normal en local — dejarlas sin definir es lo correcto aquí.
# El token del cluster es un PAT de grano fino con Issues:write sobre el repo y nada más.
# VIGIA_GITHUB_TOKEN=
# VIGIA_GITHUB_REPO=liontech-solution/deal-tracker
# VIGIA_GITHUB_API=https://api.github.com
# Aviso de lentitud (#111): el vigía cronometra cada capa, la normaliza a segundos por unidad
# (por hoja, por producto) y la guarda en `vigia_run`. Si hoy se sale del factor respecto a la
# mediana de las últimas ejecuciones de esa tienda, avisa — nunca es accionable, así que un vigía
# lento no abre issue por sí solo. Con menos de 2 muestras previas no hay línea base y no compara.
# SCRAPER_VIGIA_FACTOR_AVISO=3.0 # factor sobre la línea base a partir del cual se avisa
# SCRAPER_VIGIA_BASE_MUESTRAS=4  # ejecuciones previas que entran en la mediana de la línea base
# Plazo que el vigía se impone (#258). En el cluster el CronJob lo mata por `activeDeadlineSeconds`
# y en `DeadlineExceeded` Kubernetes BORRA el pod, así que el log no se recupera ni después: el
# 07/08/2026 el barrido murió sin decir en qué tienda se atascó. Con esto deja de barrer antes de
# que lo maten, nombra lo que quedó sin sondear y sale por el camino normal. Se pone por debajo del
# `activeDeadlineSeconds` del CronJob, con margen para el cierre. `0` (por defecto) lo desactiva,
# que es lo que quieres en local: aquí nadie te mata el proceso.
# SCRAPER_VIGIA_PLAZO_SEGUNDOS=0 # segundos de barrido antes de cortar; 0 = sin plazo
# Progreso de la pasada (#146): sin esto una pasada de horas es indistinguible de una colgada — la
# fría de Hipercor corrió 5 h y escribió 0 bytes. Va por tiempo, así que el log no crece con el
# catálogo y una pasada caliente (Zara, 1m35s) no llega a emitir ni un aviso.
# SCRAPER_PROGRESS_EVERY_SECONDS=300 # cada cuánto dice por dónde va; 0 lo desactiva
# SCRAPER_LOG_LEVEL=INFO         # WARNING calla el progreso y los `logger.info()` de las tiendas
# Espera máxima por un lock (#169). La otra mitad del problema anterior: una pasada BLOQUEADA
# también parece lenta, y sin tope espera hasta agotar el `activeDeadlineSeconds` del Job (5 h en
# Hipercor) sin hacer nada. La causa típica es el backend huérfano de una pasada anterior muerta,
# que la ingesta atómica hace probable. Al saltar, el error nombra el problema y a la sesión que
# retiene las filas. Acota cada ESPERA, no la transacción: una pasada larga legítima no lo nota.
# SCRAPER_LOCK_TIMEOUT=30        # segundos; 0 desactiva (espera infinita, el comportamiento previo)
# Espera máxima por el advisory lock que serializa las MIGRACIONES con el migrador del web (#298).
# Es otra espera y por eso es otra variable: arriba lo que estorba es una transacción huérfana
# sobre las filas, y ahí 30 s de espera ya son una avería. Aquí quien lo retiene está aplicando el
# esquema legítimamente, y algunas migraciones obligan a un `REINDEX` (0014, 0029) que sobre el
# catálogo entero no cabe en 30 s: apretarlo haría fallar pasadas por una migración lenta y normal.
# SCRAPER_MIGRATION_LOCK_WAIT=300 # segundos; 0 espera lo que haga falta
# Tiempo máximo que nuestra transacción puede estar OCIOSA antes de que Postgres mate la sesión
# (#210). Es la otra mitad de #169 y apunta al revés: el `SCRAPER_LOCK_TIMEOUT` de arriba salva a la
# pasada que se topa con una huérfana, y ésta mata a la huérfana — la aplica el SERVIDOR, así que
# sigue contando cuando el pod ya no existe, que es el único momento en que hace falta.
# Cuidado al bajarlo: la fase 1 no ejecuta SQL mientras lista, así que un valor por debajo del
# listado más largo mata pasadas buenas. Medido el 14/08/2026 sobre la vuelta de QA del 10/08, el
# peor es Hipercor con 3m; hm, sfera, lefties y mango van entre 1 y 2 min. La hora de aquí es
# margen a propósito, porque quedarse corto cuesta una pasada y pasarse solo cuesta esperar.
# SCRAPER_IDLE_TX_TIMEOUT=3600   # segundos; 0 desactiva (la huérfana vive para siempre, como antes)
